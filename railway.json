{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python manage.py collectstatic --noinput --clear"
  },
  "deploy": {
    "startCommand": "python manage.py migrate && gunicorn mind_nest.wsgi:application --bind 0.0.0.0:$PORT --log-file -"
  }
}
